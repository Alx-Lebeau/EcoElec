# Rendus Quarto
/_rendu/
/.quarto/
*_files/
/*.tex
/*.log
/*.aux
/*.toc

# Résultats de calcul en cache (freeze) : locaux, et mis en cache par la CI
# (actions/cache) plutôt que versionnés, pour ne pas alourdir l'historique.
/_freeze/

# Decks générés par `ecoelec generer` (à partir de modules/ et parcours/)
/decks/

# Accueil React (accueil/) : dépendances npm
node_modules/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Données téléchargées par les scripts de data/ (non versionnées)
/data/telechargements/

# Divers
.DS_Store
*.swp

**/*.quarto_ipynb

# Configuration locale de l’aperçu des slides (Claude Code)
/.claude/launch.json
